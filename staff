<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Concept School Shibra Campus - Staff & Payroll</title>
    <!-- Tailwind CSS for Responsive Design (Mobile & Desktop) -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 text-slate-800 font-sans">

    <!-- Navbar -->
    <header class="bg-indigo-700 text-white shadow-md sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 py-3 flex justify-between items-center">
            <div>
                <h1 class="text-base md:text-xl font-bold">🏫 Concept School Shibra Campus</h1>
                <p class="text-xs text-indigo-200">Staff, Leaves & Payroll Module</p>
            </div>
            <div class="space-x-1 sm:space-x-2">
                <a href="accounts.html" class="text-xs bg-indigo-800 hover:bg-indigo-900 px-2.5 py-1.5 rounded-lg transition">💰 Accounts</a>
                <a href="fees.html" class="text-xs bg-indigo-800 hover:bg-indigo-900 px-2.5 py-1.5 rounded-lg transition">💸 Fees</a>
                <a href="books.html" class="text-xs bg-indigo-800 hover:bg-indigo-900 px-2.5 py-1.5 rounded-lg transition">📚 Books</a>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 py-6 grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        <!-- SECTION 1: Staff Registration & Salary Entry Form -->
        <section class="bg-white p-5 rounded-xl shadow-sm border border-slate-200 lg:col-span-1">
            <h2 class="text-lg font-semibold mb-4 text-indigo-700 border-b pb-2">Staff & Payroll Entry</h2>
            
            <form id="staffForm" class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Staff Member Name</label>
                    <input type="text" id="staffName" required placeholder="e.g. Sir Ahmed / Madam Ayesha" class="w-full border rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">Designation</label>
                        <input type="text" id="designation" required placeholder="e.g. Math Teacher" class="w-full border rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">Joining Date</label>
                        <input type="date" id="joiningDate" required class="w-full border rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">Base Salary (PKR)</label>
                        <input type="number" id="baseSalary" required min="0" placeholder="0" oninput="calculateNetSalary()" class="w-full border rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">Leaves Taken</label>
                        <input type="number" id="leavesCount" min="0" value="0" placeholder="0" class="w-full border rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
                    </div>
                </div>

                <!-- Bonus & Fine Section -->
                <div class="grid grid-cols-2 gap-3 bg-indigo-50/50 p-3 rounded-lg border border-indigo-100">
                    <div>
                        <label class="block text-xs font-medium text-indigo-900 mb-1">Bonus (+) PKR</label>
                        <input type="number" id="bonusVal" min="0" value="0" oninput="calculateNetSalary()" class="w-full border rounded-lg p-2 text-xs bg-white outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-indigo-900 mb-1">Fine / Deduction (-) PKR</label>
                        <input type="number" id="fineVal" min="0" value="0" oninput="calculateNetSalary()" class="w-full border rounded-lg p-2 text-xs bg-white outline-none">
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-semibold text-slate-900 mb-1">Net Payable Salary (PKR)</label>
                    <input type="text" id="netSalary" readonly class="w-full bg-slate-100 font-bold text-indigo-700 border rounded-lg p-2.5 text-base outline-none" value="0">
                </div>

                <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2.5 rounded-lg transition text-sm shadow-sm">
                    Save Staff Record to Sheet
                </button>
            </form>
        </section>

        <!-- SECTION 2: Staff Directory & Payroll Table -->
        <section class="bg-white p-5 rounded-xl shadow-sm border border-slate-200 lg:col-span-2">
            <div class="flex justify-between items-center mb-4 border-b pb-2">
                <h2 class="text-lg font-semibold text-indigo-700">Staff Directory & Salary Ledger</h2>
                <button onclick="fetchStaff()" class="text-xs bg-slate-100 hover:bg-slate-200 text-slate-700 px-3 py-1.5 rounded-lg border transition">
                    🔄 Refresh Staff
                </button>
            </div>

            <!-- Responsive Table Container -->
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-sm">
                    <thead>
                        <tr class="bg-slate-100 text-slate-600 border-b">
                            <th class="p-3">Staff Name</th>
                            <th class="p-3">Designation</th>
                            <th class="p-3">Base Salary</th>
                            <th class="p-3">Leaves</th>
                            <th class="p-3">Net Salary</th>
                            <th class="p-3 text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody id="staffTableBody">
                        <tr>
                            <td colspan="6" class="p-4 text-center text-slate-400">Loading staff records...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

    </main>

    <!-- JavaScript Logic -->
    <script>
        const API_URL = 'https://sheetdb.io/api/v1/YOUR_SHEETDB_ID';

        function calculateNetSalary() {
            let base = parseFloat(document.getElementById('baseSalary').value) || 0;
            let bonus = parseFloat(document.getElementById('bonusVal').value) || 0;
            let fine = parseFloat(document.getElementById('fineVal').value) || 0;

            let net = base + bonus - fine;
            document.getElementById('netSalary').value = net > 0 ? net.toFixed(2) : 0;
        }

        document.getElementById('staffForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            const staffData = {
                staff_id: 'STF-' + Date.now(),
                name: document.getElementById('staffName').value,
                designation: document.getElementById('designation').value,
                joining: document.getElementById('joiningDate').value,
                base: document.getElementById('baseSalary').value,
                leaves: document.getElementById('leavesCount').value,
                net_salary: document.getElementById('netSalary').value,
                date: new Date().toLocaleDateString()
            };

            alert("Staff & Payroll Record Saved Successfully! (Connect SheetDB API URL to sync with Google Sheets).");
            console.log("Staff Data:", staffData);
        });

        async function fetchStaff() {
            console.h("Fetching staff records...");
        }
    </script>
</body>
</html>
